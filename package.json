{
  "name": "ai-form-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && vite build -c vite.content.config.ts && vite build -c vite.background.config.ts",
    "watch": "vite build --watch & vite build --watch -c vite.content.config.ts & vite build --watch -c vite.background.config.ts & wait",
    "serve:test": "python3 -m http.server 8899 -d dist",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^15.11.7",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
