# Copy to .env and fill in the keys you use. Keys are NEVER committed —
# they seed the Settings panel only when that provider's key is empty there.
# Build-time seeding: VITE_<PROVIDER>_API_KEY → Settings keys[<provider>].
# Runtime values saved in Settings always win over these — no rebuild needed.

# OpenAI — https://platform.openai.com/api-keys
# VITE_OPENAI_API_KEY=sk-...

# Groq — https://console.groq.com/keys
# VITE_GROQ_API_KEY=gsk_...

# NVIDIA — https://build.nvidia.com
VITE_NVIDIA_API_KEY=nvapi-...

# Ollama — local server at http://localhost:11434/v1 (optional — leave empty for local)
# VITE_OLLAMA_API_KEY=

# Custom Provider — any OpenAI-compatible endpoint (vLLM, SGLang, LM Studio…), optional
# VITE_CUSTOM_API_KEY=
